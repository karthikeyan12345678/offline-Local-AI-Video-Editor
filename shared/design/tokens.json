{
  "$description": "Shared design tokens. Source of truth, extracted from the supplied ChatGPT DESIGN.md. Run `node build-tokens.mjs` to regenerate tokens.css.",
  "color": {
    "bg": "#FFFFFF",
    "text": "#0D0D0D",
    "accent": "#2C67C5",
    "gray-1": "#EDEDED",
    "gray-2": "#CDCDCD",
    "gray-3": "#B4B4B4",
    "gray-4": "#AFAFAF"
  },
  "font": {
    "family": "-apple-system, \"Segoe UI\", system-ui, Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "ui-monospace, \"Cascadia Mono\", Consolas, Menlo, monospace",
    "weight": { "regular": 400, "medium": 500, "semibold": 600 }
  },
  "text": {
    "xs": { "size": "12px", "line": "16px" },
    "sm": { "size": "14px", "line": "20px" },
    "base": { "size": "16px", "line": "24px" },
    "lg": { "size": "18px", "line": "26px" },
    "xl": { "size": "24px", "line": "28.8px" }
  },
  "space": {
    "1": "1px",
    "2": "2px",
    "3": "3px",
    "4": "4px",
    "5": "6px",
    "6": "8px",
    "7": "10px",
    "8": "14px",
    "9": "16px",
    "10": "20px",
    "11": "64px",
    "12": "251px"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "26px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "rgba(255, 255, 255, 0.2) 0px 0px 1px 0px inset"
  },
  "motion": {
    "fast": "opacity 0.15s cubic-bezier(0.4, 0, 0.2, 1), color 0.15s, background-color 0.15s, border-color 0.15s"
  }
}
