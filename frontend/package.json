{
  "name": "ltx-portable-studio-ui",
  "private": true,
  "version": "1.2.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "prepare:web": "node scripts/prepare-web.mjs",
    "build:web": "node scripts/prepare-web.mjs && tsc --noEmit && vite build --mode web --outDir dist-web && cd ../assistant-ui && npm install --no-audit --no-fund && npm run build:web",
    "preview:web": "vite preview --outDir dist-web --port 4173"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@gradio/client": "^2.7.1",
    "pyodide": "^0.27.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.56.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
